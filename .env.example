# Browser-safe Supabase values. NEVER expose a service_role key to Vite/client code.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Production public URL used for client invitations, email confirmation and password recovery.
# Local development automatically falls back to the current localhost origin.
VITE_PUBLIC_APP_URL=https://YOUR_PUBLIC_DOMAIN/